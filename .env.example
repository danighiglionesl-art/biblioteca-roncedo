# =========================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BIBLIOTECA RONCEDO
# Configurar estas variables en Vercel y en tu archivo local .env.local
# =========================================================

# URL canónica de la plataforma (Producción: https://www.bibliotecaroncedo.ar)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexión a Supabase (PostgreSQL y Auth)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Clave de servicio para operaciones administrativas de servidor (Opcional)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-aqui

# =========================================================
# PROVEEDORES DE PAGO (SOLO EN SERVIDOR / BACKEND - NUNCA EXPONER EN CLIENTE)
# =========================================================

# Mercado Pago (Suscripciones y Webhooks)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-tu-access-token-privado-aqui
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret-de-mercadopago

# Mobbex (Preparado para futura integración)
MOBBEX_API_KEY=tu-mobbex-api-key
MOBBEX_ACCESS_TOKEN=tu-mobbex-access-token
